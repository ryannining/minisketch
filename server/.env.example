# EXAMPLE configuration for the MiniSketch AI bridge.
#
# Nothing here is required. The API key belongs to whoever RUNS MiniSketch,
# and there is deliberately no default baked into the source: a key that lives
# in the repository leaks with the repository.
#
# Three ways to give the bridge an endpoint, in the order the bridge uses them:
#
#   1. From the app. MiniSketch Settings -> "AI chat" has "AI API base URL",
#      "AI API key" and "AI model". Whatever you fill in there travels with
#      every chat request, and the bridge keeps no copy of it.
#   2. From the app, once. The app can POST the same values to
#      /api/settings; the bridge then remembers them in memory (and forgets
#      them when it stops).
#   3. From this file. A self-hosted bridge for one person — the values here
#      are the fallback when the request carries none.
#
# Copy this file to server/.env and fill in what you need.

# Base URL of your OpenAI-compatible endpoint, WITHOUT /chat/completions
OPENAI_BASE_URL=

# API key for the endpoint above
OPENAI_API_KEY=

# Model name the bridge sends in every request (when the request names none)
MODEL=

# Local port for the bridge (match "AI bridge URL" in MiniSketch settings)
AI_BRIDGE_PORT=8787

# Extra origins allowed to call the bridge, comma separated, exact.
# By default the bridge accepts: a local file (the app opened from disk),
# any localhost / 127.0.0.1 port, and a private LAN address (the phone or
# tablet talking to this PC). Everything else is refused, so a random web
# page cannot spend your key.
# AI_ALLOWED_ORIGINS=https://minisketch.example.com
