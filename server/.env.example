# EXAMPLE configuration for the MiniSketch AI bridge.
# Copy this file to server/.env and fill in your values — the bridge loads
# server/.env at startup (shell environment still overrides it). Without a
# .env the bridge falls back to the defaults hardcoded in ai-bridge.js.

# Base URL of your OpenAI-compatible endpoint, WITHOUT /chat/completions
# Z.ai example:   https://api.z.ai/api/coding/paas/v4
OPENAI_BASE_URL=

# API key for the endpoint above
OPENAI_API_KEY=

# Model name the bridge sends in every request
# Z.ai example:   glm-5.3-flash
MODEL=

# Local port for the bridge (match "AI bridge URL" in MiniSketch settings)
AI_BRIDGE_PORT=8787
